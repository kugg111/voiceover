<ui:FluentWindow x:Class="Voiceover.Client.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Voiceover - Register" Height="450" Width="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Assets/AppIcon.png"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <!-- Same slowly-rotating gradient as LoginWindow - see its own comment
         for the reasoning. Kept as a separate copy rather than a shared
         resource since these are two independent top-level windows, each
         with their own NameScope that Storyboard.TargetName needs. -->
    <ui:FluentWindow.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <LinearGradientBrush.RelativeTransform>
                <RotateTransform x:Name="BgGradientRotate" CenterX="0.5" CenterY="0.5" Angle="0"/>
            </LinearGradientBrush.RelativeTransform>
            <GradientStop Offset="0.0" Color="#12182B"/>
            <GradientStop Offset="0.5" Color="#1B2A4A"/>
            <GradientStop Offset="1.0" Color="#0B0F1C"/>
        </LinearGradientBrush>
    </ui:FluentWindow.Background>
    <ui:FluentWindow.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BgGradientRotate" Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:25" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </ui:FluentWindow.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Voiceover" Grid.Row="0" ShowMaximize="False"/>

        <Grid Grid.Row="1" Margin="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Create an account" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextNormal}" Margin="0,0,0,4"/>
            <TextBlock Text="Join Voiceover in just a few clicks." FontSize="13"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,20"/>

            <TextBlock Text="USERNAME" FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameBox" Height="36" Padding="8,6"
                     Background="{StaticResource BgDarker}" Foreground="{StaticResource TextNormal}"
                     BorderThickness="0" Margin="0,0,0,14" KeyDown="UsernameOrPasswordBox_KeyDown"/>

            <TextBlock Text="PASSWORD" FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Height="36" Padding="8,6"
                         Background="{StaticResource BgDarker}" Foreground="{StaticResource TextNormal}"
                         BorderThickness="0" Margin="0,0,0,14" KeyDown="UsernameOrPasswordBox_KeyDown"/>

            <CheckBox x:Name="RememberMeBox" Content="Remember me" IsChecked="True"
                      Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"/>

            <TextBlock x:Name="StatusText" Foreground="{StaticResource DangerRed}" FontSize="12"
                       Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>

            <Button x:Name="RegisterSubmitButton" Content="Register" Height="40" Width="200"
                    HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                    Background="{StaticResource AccentBlurple}" Foreground="White"
                    BorderThickness="0" FontWeight="Bold" Cursor="Hand"
                    Click="RegisterSubmitButton_Click" Margin="0,0,0,8"/>

            <Button x:Name="BackToLoginButton" Content="Already have an account? Log In" Height="36"
                    HorizontalAlignment="Center" HorizontalContentAlignment="Center" Padding="12,0"
                    Background="Transparent" Foreground="{StaticResource TextMuted}"
                    BorderThickness="0" Cursor="Hand" Click="BackToLoginButton_Click"/>
        </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
